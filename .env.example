# =============================================================================
# Finance Pilot — contrat d’environnement (voir `lib/env.ts` : getCanonicalEnv)
# =============================================================================
# Renseigner toutes les clés ci-dessous (local : `.env` ou `.env.local`).
# Aucune autre variable n’est lue par l’appli côté configuration.
#
# Build Docker : l’image active `SKIP_ENV_VALIDATION=1` uniquement pendant `pnpm build`
# (jeu factice) ; le conteneur en exécution doit fournir les vraies valeurs.
# =============================================================================

NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0

NEXT_PUBLIC_MATOMO_URL=""
NEXT_PUBLIC_MATOMO_SITE_ID=""

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/finance_pilot"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optionnel : extraction IA d'une fiche de paye (Mistral Document AI, plan Experiment sur console.mistral.ai)
MISTRAL_API_KEY=""
