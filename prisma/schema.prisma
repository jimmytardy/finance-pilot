generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Bulletin de paie mensuel, ou fiche distincte d'épargne salariale (intéressement, participation).
enum PayslipKind {
  BULLETIN
  EPARGNE_SALARIALE
}

enum PayslipBloc {
  REMUNERATION
  PARTAGE_VALEUR
  FIN_CONTRAT
  COTISATION
  IMPOT
  AJUSTEMENT_NET
}

enum PayslipFrequence {
  MENSUELLE
  TRIMESTRIELLE
  ANNUELLE
  PONCTUELLE
}

enum PayslipRegimeSocial {
  NORMAL
  REDUIT
  EXONERE
  SPECIFIQUE
}

enum PayslipModeEpargne {
  PLACE
  PERCU
  INCONNU
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String              @id @default(cuid())
  name               String?
  email              String?             @unique
  emailVerified      DateTime?
  image              String?
  accounts           Account[]
  sessions           Session[]
  simulatorState     SimulatorState?
  employers          Employer[]
  employmentPeriods EmploymentPeriod[]
  payslips           Payslip[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SimulatorState {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payload   Json
  updatedAt DateTime @updatedAt
}

model Employer {
  id                  String               @id @default(cuid())
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  employmentPeriods EmploymentPeriod[]
  payslips            Payslip[]

  @@index([userId])
}

model EmploymentPeriod {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employerId String
  employer   Employer  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  startDate  DateTime  @db.Date
  endDate    DateTime? @db.Date
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([employerId])
}

model Payslip {
  id                         String       @id @default(cuid())
  userId                     String
  user                       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  employerId                 String?
  employer                   Employer?    @relation(fields: [employerId], references: [id], onDelete: SetNull)
  kind                       PayslipKind  @default(BULLETIN)
  year                       Int
  month                      Int
  label                      String?
  /// Totaux recopiés du document (source de vérité, jamais recalculés depuis les lignes).
  brut                       Decimal      @db.Decimal(14, 2)
  netAvantImpot              Decimal      @db.Decimal(14, 2)
  netImposable               Decimal      @db.Decimal(14, 2)
  netSocial                  Decimal?     @db.Decimal(14, 2)
  netPaye                    Decimal      @db.Decimal(14, 2)
  prelevementSource          Decimal      @default(0) @db.Decimal(14, 2)
  tauxPas                    Decimal?     @db.Decimal(6, 3)
  totalCotisationsSalariales Decimal?     @db.Decimal(14, 2)
  totalCotisationsPatronales Decimal?     @db.Decimal(14, 2)
  coutEmployeur              Decimal?     @db.Decimal(14, 2)
  heuresTravaillees          Decimal?     @db.Decimal(8, 2)
  plafondSS                  Decimal?     @db.Decimal(14, 2)
  /// Cumuls annuels du bandeau (brut, imposable, heures sup exonérées…).
  cumuls                     Json?
  notes                      String?      @db.Text
  /// Modèle IA ayant extrait le document, null si saisie manuelle.
  extractedBy                String?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
  lines                      PayslipLine[]

  @@index([userId, year, month])
}

model PayslipLine {
  id                  String               @id @default(cuid())
  payslipId           String
  payslip             Payslip              @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  position            Int
  bloc                PayslipBloc
  /// Identifiant de catégorie validé par `lib/payslip-categories.ts`.
  categorie           String
  libelle             String
  base                Decimal?             @db.Decimal(14, 2)
  quantite            Decimal?             @db.Decimal(10, 2)
  tauxSalarial        Decimal?             @db.Decimal(8, 4)
  montantSalarial     Decimal?             @db.Decimal(14, 2)
  tauxPatronal        Decimal?             @db.Decimal(8, 4)
  montantPatronal     Decimal?             @db.Decimal(14, 2)
  /// Gains et ajustements (signé : négatif = retenue).
  montant             Decimal?             @db.Decimal(14, 2)
  frequence           PayslipFrequence?
  regimeSocial        PayslipRegimeSocial?
  imposable           Boolean?
  exonerationIr       Boolean?
  verseEnNumeraire    Boolean              @default(true)
  modeEpargne         PayslipModeEpargne?
  csgCrds             Decimal?             @db.Decimal(14, 2)
  periodeRattachement String?

  @@index([payslipId])
}
